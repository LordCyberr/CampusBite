# ==============================================================================
# CampusBite Root .gitignore
# ==============================================================================

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database files (local SQLite)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
campusbite.db
backend/campusbite.db

# Environment and sensitive configuration files
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.env

# Application logs
logs/
backend/logs/
*.log

# Node.js / Frontend dependencies and production builds
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
.eslintcache

# Operating System and IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Student Private Study Materials, Prompts and Internal Notes (Private)
Phase/
*MASTER_PROMPT*.md
*PROMPT*.md
project-docs/

# Temporary installer and system batch scripts
*.bat
*.ps1
