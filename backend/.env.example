# ==============================================================================
# CampusBite Backend Environment Variables Template
# Copy this file to .env in the backend directory and set your actual values:
#   cp .env.example .env
# Never commit the real .env file or production secrets to version control.
# ==============================================================================

# Application Environment (development | production)
# In production, the backend will refuse to start if SECRET_KEY is missing, empty,
# or set to a known insecure placeholder.
APP_ENV=development

# Database Connection URL
# SQLite: sqlite:///./campusbite.db (local) or sqlite:////data/campusbite.db (Docker volume)
# PostgreSQL: postgresql://campususer:change-me@postgres:5432/campusbite
DATABASE_URL=sqlite:///./campusbite.db

# JWT Authentication
# IMPORTANT: In production, generate a secure random 32+ character key.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Order Insights (OpenAI API Key)
# Optional: If unconfigured, the app runs normally and returns friendly notices on /ai/insights.
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini

# Background Stuck-Order Reminder Worker
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_SECONDS=60
REMINDERS_ENABLED=true

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173
