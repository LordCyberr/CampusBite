# ==============================================================================
# CampusBite Environment Variables Template
# Copy this file to .env or backend/.env
# Never commit real secret keys or passwords to version control.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Database Connection (SQLite by default; PostgreSQL for production containers)
DATABASE_URL=sqlite:///./campusbite.db

# Authentication Secrets
# Generate in production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-secure-random-32-character-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Order Insights (Optional: system provides friendly fallbacks if unconfigured)
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini

# Background Stuck-Order Reminder Worker
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_SECONDS=60
REMINDERS_ENABLED=true

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Configuration
VITE_API_URL=http://localhost:8000
VITE_SHOW_DEMO_LOGINS=true
